<?xml version="1.0" encoding="utf-8"?>
<!-- Adhkar widget: shows the dhikr appropriate for the current time
     (morning before noon, evening after Asr). Tapping opens the in-app
     adhkar screen with the matching set. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_mosque"
            android:tint="#D4A853"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/adhkar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أذكار الصباح"
            android:textColor="#D4A853"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/adhkar_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9A9588"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Dhikr text -->
    <TextView
        android:id="@+id/adhkar_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="--"
        android:textColor="#F0EDE4"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.3"
        android:maxLines="4"
        android:ellipsize="end" />

    <!-- Footer hint -->
    <TextView
        android:id="@+id/adhkar_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="اضغط لفتح الأذكار"
        android:textColor="#6B6358"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
